{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "中華道藏",
  "version": "1.0.0",
  "identifier": "com.daozang.zhonghua",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "中華道藏 · 神仙圖鑑",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ],
    "resources": ["resources/daozang.db"]
  }
}
